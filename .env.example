# 慢病管家 · 环境变量模板
# 复制为 .env 并填入你的真实值
# .env 已在 .gitignore 里，不会上传

# ===== SendGrid（邮件服务）=====
# 在 https://app.sendgrid.com/ 注册并创建 API Key
# 需要 Mail Send 权限（Full Access 最简单）
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 发件人邮箱（必须先在 SendGrid 验证）
# 单个发件人：singular@example.com
# 多发件人：需要先在 SendGrid 创建 Sender
SENDGRID_FROM_EMAIL=noreply@chroniccare.app
SENDGRID_FROM_NAME=慢病管家

# ===== 应用模式 =====
# true = 邮件不真发，只打印日志（开发/调试用）
# false = 真发邮件（生产用）
EMAIL_USE_MOCK=true

# ===== 失联检测 =====
# 默认 48 小时，可改 24/48/72
CHECKIN_CYCLE_HOURS=48

# ===== 数据库 =====
# 默认本地 SQLite，不需要改
# v1.0+ 云同步时配置 Postgres：
# DATABASE_URL=postgres://user:pass@host:5432/chroniccare

# ===== Apple Developer（上 store 前必填，v0.30 R96 软隐藏）=====
# fastlane/Appfile 已改 ENV 模式，真实值从这里读
# Apple Developer 后台: https://developer.apple.com
#   - APPLE_ID: App Store Connect 登录邮箱
#   - TEAM_ID: Apple Developer → Membership → Team ID (10 字符)
#   - ITC_TEAM_ID: App Store Connect → Users and Access → Keys → (选 org)
APPLE_ID=your-apple-id@example.com
TEAM_ID=YOUR_TEAM_ID
ITC_TEAM_ID=YOUR_ITC_TEAM_ID

# 替代方案（推荐，更安全）：API Key 模式
# 详见 fastlane/Appfile 顶部注释
# APPLE_KEY_ID=
# APPLE_ISSUER_ID=
# APPLE_KEY_FILEPATH=
