# 慢病管家 · 环境变量模板
# 复制为 .env 并填入你的真实值
# .env 已在 .gitignore 里，不会上传

# ===== SendGrid（邮件服务）=====
# 在 https://app.sendgrid.com/ 注册并创建 API Key
# 需要 Mail Send 权限（Full Access 最简单）
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 发件人邮箱（必须先在 SendGrid 验证）
# 单个发件人：singular@example.com
# 多发件人：需要先在 SendGrid 创建 Sender
SENDGRID_FROM_EMAIL=noreply@chroniccare.app
SENDGRID_FROM_NAME=慢病管家

# ===== 应用模式 =====
# true = 邮件不真发，只打印日志（开发/调试用）
# false = 真发邮件（生产用）
EMAIL_USE_MOCK=true

# ===== 失联检测 =====
# 默认 48 小时，可改 24/48/72
CHECKIN_CYCLE_HOURS=48

# ===== 数据库 =====
# 默认本地 SQLite，不需要改
# v1.0+ 云同步时配置 Postgres：
# DATABASE_URL=postgres://user:pass@host:5432/chroniccare
