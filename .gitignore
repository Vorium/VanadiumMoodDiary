*.pyc
.pytest_cache/

# In-progress test scaffolds (R57+ AliyunSmsProvider 等依赖未加 pubspec 时用)
*.disabled

# R61 backup directories (auto-generated by flutter commit / git hooks)
.r61_backup_*/

# v0.27 round 67 (Sprint 1, googleplay C-P0-9): 兜底防 keystore 误 commit
# (android/.gitignore 已排除 *.jks / *.keystore / key.properties, 这里是
# root 层兜底 — 万一用户把 keystore 移到根目录或 .gradle 目录, 也能拦住)
*.jks
*.keystore
key.properties

# v0.27 round 73 (重构-2): 设计师迭代产物 / 100 个 variations 候选不进 git
# 实际只上架用: assets/brand/app_icon_master.png + app_icon_maskable.png
# + icon_showcase.html。其他 100 variations + _v2..v5 迭代 + icon_preview_v2..v5
# 已 git mv 到 assets/brand/_archive/ (R42 报告 M6 落地, 节省 ~10 MB git objects)
# .gitignore 兜底: 设计师后续新加的 _v6 / variations_k.png 自动不 commit
assets/brand/_archive/
assets/brand/variations/
assets/brand/*_v[2-9]*.png
assets/brand/icon_preview_v[2-9]*.png

# v0.27 round 73 (重构-3): scripts/ root 临时输出 (.txt) 跟迭代日志不进 git
# 之前 11 个 .txt 临时输出 (diff_stat / final_stats / gitlog* / list* / status*)
# + test_delivery_rate.dart (R42 报告 M3 候选, R71 后已是 deprecated)
# 已 git rm / git mv 处理。.gitignore 兜底防再增。
scripts/*.txt
scripts/test_delivery_rate.dart

# v0.30 round 92 (cleanup): 兜底排除 IntelliJ 项目文件
# (R60+ 已有 *.iml 通配符, 这里加具体文件名更显眼, 万一 .gitignore 通配规则被 IDE 改动也能拦住)
chroniccare.iml

# v0.30 R108 revisit: 兜底排除 build/工具产物 (不进 commit)
# - .gradle-*-all.zip: Flutter Gradle wrapper download (500MB+)
# - coverage/: flutter test --coverage 输出 (R95+ 临时)
# - .mavis-trash/: mavis session 删文件时移到这里, 不进 commit
.gradle-*-all.zip
coverage/
.mavis-trash/

