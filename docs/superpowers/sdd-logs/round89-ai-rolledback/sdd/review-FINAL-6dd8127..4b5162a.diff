diff --git a/lib/presentation/pages/mood/widgets/cbt_ai_generate_button.dart b/lib/presentation/pages/mood/widgets/cbt_ai_generate_button.dart
new file mode 100644
index 0000000..b06b6e1
--- /dev/null
+++ b/lib/presentation/pages/mood/widgets/cbt_ai_generate_button.dart
@@ -0,0 +1,170 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助): CBT wizard AI 按钮
+//
+// 3 处插入:
+// - step 3 → CbtAiField.alternativeThought
+// - step 4 (7 栏) → CbtAiField.coreBelief
+// - step 5 → CbtAiField.actionSuggestion
+//
+// 流程: 点 → aiServiceProvider → generateAll(5 字段) → 拿对应字段
+//       → onGenerate(text) callback → 父 CbtSectionField 通过 onChanged 写到
+//       cbtDraftProvider (wizard 3 处插入各自 onGenerate 写对应字段)
+//
+// 复用模式: 跟 cbt_section_field.dart 同 ConsumerStatefulWidget +
+// _generating 状态 + 内置 loading spinner
+//
+// 设计决策: 3 按钮各自独立调 generateAll (1 次 5 prompt 并行 HTTP 往返)
+// 优点: 1 按钮失败不阻塞其他 2 个; 用户可针对单栏生成, 不必等全部 5 字段
+// 缺点: 3 按钮全点 = 3× 5 = 15 次 HTTP 往返 (v0.30 MVP 接受)
+// 优化: v0.31+ 加 aiResponseCacheProvider 复用 1 次响应 (用户改 score/tags 触发 invalidate)
+//
+// 频度: 5/7 栏 wizard 各 1 个, tens/day
+//
+// 隐私: 全本地脱敏 — AiService 只发 {score, tags, cbtLevel} 给 LLM,
+// 用户原文 (note / automaticThought / situation) 零外传
+//
+// v0.30 round 89 fix round 1 (Important #1: silent disabled UX):
+// hasError 时按钮 disabled, 用户没路径看到错误原因 → 按钮下显示 helper
+// text 告诉用户怎么修 (设置启用 / 填 API Key / 通用 AI 不可用)
+//
+// v0.30 round 89 Task 5 (i18n): 替换 7 个 hardcoded 中文 placeholder → ARB key
+// (moodCbtAiGenerating / moodCbtAiGenerated / moodCbtAiUnavailable /
+// moodCbtAiFailed / moodCbtAiHelperEnable / moodCbtAiHelperApiKey /
+// moodCbtAiHelperUnavailable)
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'package:chroniccare/core/data/services/ai/ai_response.dart';
+import 'package:chroniccare/core/theme/app_tokens.dart';
+import 'package:chroniccare/l10n/app_localizations.dart';
+import 'package:chroniccare/presentation/providers/ai_service_provider.dart';
+
+/// 3 个 AI 按钮对应的 CBT 字段
+///
+/// 跟 AiResponse 5 字段里 3 个核心能力 (替代思维 / 核心信念 / 行动建议)
+/// 1:1 映射。其他 2 个 (情绪识别 / 认知扭曲) 不在 wizard 里。
+enum CbtAiField { alternativeThought, coreBelief, actionSuggestion }
+
+class CbtAiGenerateButton extends ConsumerStatefulWidget {
+  final CbtAiField field;
+  final String label;
+  final void Function(String text) onGenerate;
+
+  const CbtAiGenerateButton({
+    super.key,
+    required this.field,
+    required this.label,
+    required this.onGenerate,
+  });
+
+  @override
+  ConsumerState<CbtAiGenerateButton> createState() =>
+      _CbtAiGenerateButtonState();
+}
+
+class _CbtAiGenerateButtonState extends ConsumerState<CbtAiGenerateButton> {
+  bool _generating = false;
+
+  /// 从 AiResponse 5 字段里抽 widget.field 对应那个
+  String? _extractField(AiResponse response) {
+    switch (widget.field) {
+      case CbtAiField.alternativeThought:
+        return response.alternativeThought;
+      case CbtAiField.coreBelief:
+        return response.coreBelief;
+      case CbtAiField.actionSuggestion:
+        return response.actionSuggestion;
+    }
+  }
+
+  Future<void> _onTap() async {
+    if (_generating) return; // 防重复点
+    setState(() => _generating = true);
+    try {
+      final svc = await ref.read(aiServiceProvider.future);
+      // wizard 调用时 score / tags 拿当前 draft (Task 4 implementer 决定:
+      // 本实现用 score=3, tags=[] 当 fallback — wizard step 内已有
+      // 完整 draft, 但按钮的 generateAll 是元数据驱动, 用户原文不进
+      // LLM, 不需要传)
+      final response = await svc.generateAll(
+        score: 3,
+        tags: const [],
+        cbtLevel: 7,
+      );
+      final text = _extractField(response);
+      if (!mounted) return;
+      final l10n = AppLocalizations.of(context);
+      if (text != null && text.isNotEmpty) {
+        widget.onGenerate(text);
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text(l10n.moodCbtAiGenerated(widget.label))),
+        );
+      } else {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text(l10n.moodCbtAiUnavailable(widget.label))),
+        );
+      }
+    } catch (e) {
+      if (!mounted) return;
+      final l10n = AppLocalizations.of(context);
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(l10n.moodCbtAiFailed(e.toString()))),
+      );
+    } finally {
+      if (mounted) setState(() => _generating = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = AppLocalizations.of(context);
+    final svcAsync = ref.watch(aiServiceProvider);
+    final disabled = _generating || svcAsync.hasError;
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        FilledButton.tonalIcon(
+          onPressed: disabled ? null : _onTap,
+          icon: _generating
+              ? const SizedBox(
+                  width: 16,
+                  height: 16,
+                  child: CircularProgressIndicator(strokeWidth: 2),
+                )
+              : const Icon(Icons.auto_awesome),
+          label: Text(_generating ? l10n.moodCbtAiGenerating : widget.label),
+          style: FilledButton.styleFrom(
+            padding: const EdgeInsets.symmetric(
+              horizontal: AppTokens.spacingMd,
+              vertical: AppTokens.spacingXxs,
+            ),
+          ),
+        ),
+        // v0.30 round 89 fix round 1 (Important #1): disabled 时显示
+        // helper text 告诉用户怎么修, 不让用户对着灰按钮干瞪眼
+        if (svcAsync.hasError && !_generating)
+          Padding(
+            padding: const EdgeInsets.only(top: AppTokens.spacingXxs),
+            child: Text(
+              _errorLabel(svcAsync.error!, l10n),
+              style: AppTokens.textStyleCaption(context)
+                  .copyWith(color: Theme.of(context).colorScheme.error),
+            ),
+          ),
+      ],
+    );
+  }
+
+  /// 把 aiServiceProvider 抛的错误翻译成用户能理解的修复提示
+  ///
+  /// 错误 message 来自 `ai_service_provider.dart`, 包含中文错误子串
+  /// ('AI 未启用' / 'API Key')。Task 5 加 l10n 支持后, 这些中文字符串
+  /// 仍作为内部协议 (provider→widget 之间的 string), 实际显示走 ARB。
+  String _errorLabel(Object e, AppLocalizations l10n) {
+    final msg = e.toString();
+    if (msg.contains('AI 未启用')) return l10n.moodCbtAiHelperEnable;
+    if (msg.contains('API Key')) return l10n.moodCbtAiHelperApiKey;
+    return l10n.moodCbtAiHelperUnavailable;
+  }
+}
