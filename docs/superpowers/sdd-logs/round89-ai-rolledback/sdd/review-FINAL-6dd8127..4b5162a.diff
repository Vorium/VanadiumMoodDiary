@@ -0,0 +1,164 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助): AiSection widget 测试
+//
+// 覆盖:
+// 1. enabled=false: 标题 + Switch 渲染 + 字段 label 显示 (API Key / 模型),字段不输入
+// 2. enabled=true: TextField 全部可输入 (obscure + dropdown)
+// 3. FIX-Round-1: enabled=true 时输入文本后 rebuild 文本还在 (TextField 持
+//    controller), 点"保存"按钮 → notifier.setApiKey 被调 + snackbar 反馈
+//
+// 模式 (跟 cbt_section_round84_test 同):
+// - MaterialApp + AppLocalizations.localizationsDelegates + locale: Locale('zh')
+// - ProviderScope overrides: aiSettingsProvider → 桩 Notifier 返 stub entity
+// - Stub Notifier 必须 implements AiSettingsNotifier (不能用 super class)
+//
+// 中文 placeholder ("AI 辅助 (CBT 思维记录)" / "启用 AI 辅助" / "API Key" / "模型")
+// 暂用 — Task 5 一次性换 16 个 l10n key。
+import 'package:chroniccare/domain/entities/ai_settings.dart';
+import 'package:chroniccare/l10n/app_localizations.dart';
+import 'package:chroniccare/presentation/pages/settings/widgets/ai_section.dart';
+import 'package:chroniccare/presentation/providers/ai_settings_provider.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('AiSection 渲染 toggle + 字段 (enabled=false)', (tester) async {
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          aiSettingsProvider.overrideWith(() => _StubNotifier()),
+        ],
+        child: const MaterialApp(
+          localizationsDelegates: AppLocalizations.localizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          locale: Locale('zh'),
+          home: Scaffold(
+            body: AiSection(),
+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+    // 标题
+    expect(find.text('AI 辅助 (CBT 思维记录)'), findsOneWidget);
+    // Toggle (SwitchListTile)
+    expect(find.byType(Switch), findsOneWidget);
+    // 字段 (enabled = false 时也显示,只是 disabled)
+    expect(find.text('API Key'), findsOneWidget);
+    expect(find.text('模型'), findsOneWidget);
+  });
+
+  testWidgets('AiSection enabled = true 时字段可编辑', (tester) async {
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          aiSettingsProvider.overrideWith(() => _StubNotifierEnabled()),
+        ],
+        child: const MaterialApp(
+          localizationsDelegates: AppLocalizations.localizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          locale: Locale('zh'),
+          home: Scaffold(body: AiSection()),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+    // TextField 应该可输入
+    final tf = find.byType(TextField);
+    expect(tf, findsAtLeastNWidgets(1));
+  });
+
+  testWidgets(
+      'AiSection FIX-Round-1: TextField 持 controller (输入后 rebuild 文本不丢) + 保存按钮调 setApiKey + snackbar',
+      (tester) async {
+    final notifier = _StubNotifierEnabled();
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          aiSettingsProvider.overrideWith(() => notifier),
+        ],
+        child: const MaterialApp(
+          localizationsDelegates: AppLocalizations.localizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          locale: Locale('zh'),
+          home: Scaffold(body: AiSection()),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+
+    // 输入 API key
+    const testKey = 'sk-test-12345';
+    await tester.enterText(find.byType(TextField), testKey);
+    await tester.pumpAndSettle();
+
+    // 字段显示刚输入的文本 (controller 持有)
+    expect(find.text(testKey), findsOneWidget);
+
+    // 触发 rebuild 模拟 widget tree 状态切换 (外部 provider 改值会触发
+    // ref.watch listener, AiSection rebuild), 文本应保留 — 老实现用
+    // onSubmitted-only 的话 TextField 重建后会清空
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          aiSettingsProvider.overrideWith(() => notifier),
+        ],
+        child: const MaterialApp(
+          localizationsDelegates: AppLocalizations.localizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          locale: Locale('zh'),
+          home: Scaffold(body: AiSection()),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+    // rebuild 后文本应保留 (controller 在 State 里, initState 不会重跑)
+    expect(find.text(testKey), findsOneWidget);
+
+    // 点"保存"按钮
+    await tester.tap(find.text('保存'));
+    await tester.pumpAndSettle();
+    // notifier 收到 setApiKey(testKey) 调用
+    expect(notifier.lastSetApiKey, testKey);
+    // 成功 snackbar
+    expect(find.text('API Key 已保存'), findsOneWidget);
+  });
+}
+
+class _StubNotifier extends AsyncNotifier<AiSettings>
+    implements AiSettingsNotifier {
+  String? lastSetApiKey;
+
+  @override
+  Future<AiSettings> build() async => const AiSettings(
+        enabled: false,
+        provider: 'deepseek',
+        modelName: 'deepseek-chat',
+        consentVersion: '1.0',
+      );
+
+  @override
+  Future<void> setEnabled(bool v) async {}
+  @override
+  Future<void> setApiKey(String key) async {
+    lastSetApiKey = key;
+  }
+
+  @override
+  Future<void> setModelName(String name) async {}
+  @override
+  Future<void> recordConsent() async {}
+  @override
+  Future<void> clear() async {}
+}
+
+class _StubNotifierEnabled extends _StubNotifier {
+  @override
+  Future<AiSettings> build() async => const AiSettings(
+        enabled: true,
+        provider: 'deepseek',
+        modelName: 'deepseek-chat',
+        consentVersion: '1.0',
+        consentAcceptedAt: '2026-08-05T12:00:00Z',
+      );
+}
diff --git a/test/presentation/providers/ai_settings_provider_round89_test.dart b/test/presentation/providers/ai_settings_provider_round89_test.dart
new file mode 100644
index 0000000..681590e
--- /dev/null
+++ b/test/presentation/providers/ai_settings_provider_round89_test.dart
@@ -0,0 +1,148 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助) FIX-1: AsyncNotifier 写方法 deadlock 回归测试
+//
+// Bug: setEnabled / setModelName / recordConsent 在写前 `state = AsyncValue.loading()`
+// 后 `await future` (内部 completer 等) — 但 completer 只由外层
+// `state = await AsyncValue.guard(...)` 完成, 形成 self-deadlock。
+//
+// 复现: override aiSettingsRepositoryProvider 返一个 fake, fake.save() 永返回;
+// 调用 setEnabled(true) 后 provider state 永远卡在 AsyncValue.loading(), save()
+// 也从未被调用 (因为 await future 永 hang)。
+//
+// 修复: 在 setEnabled 入口拿 `state.valueOrNull ?? default` 当 current, 不再
+// 依赖 future。等 fix 后 save() 会被调用, state 会落到 AsyncData, test pass。
+//
+// 模式: ProviderContainer + container.read(aiSettingsProvider.notifier) —
+// 不在 widget tree 内, 干净测 AsyncNotifier 行为。
+
+import 'package:chroniccare/core/data/repositories/ai_settings/ai_settings_repository_impl.dart';
+import 'package:chroniccare/domain/entities/ai_settings.dart';
+import 'package:chroniccare/presentation/providers/ai_settings_provider.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// Fake repo 记录所有 save() 调用, 返固定 future 让 build() 完成。
+class _FakeRepo implements AiSettingsRepository {
+  int saveCount = 0;
+  AiSettings? lastSaved;
+  bool saveShouldFail = false;
+
+  @override
+  Future<AiSettings> load() async {
+    return const AiSettings(
+      enabled: false,
+      provider: 'deepseek',
+      modelName: 'deepseek-chat',
+      consentVersion: '1.0',
+    );
+  }
+
+  @override
+  Future<void> save(AiSettings settings) async {
+    saveCount++;
+    lastSaved = settings;
+    if (saveShouldFail) throw Exception('save failed');
+  }
+
+  @override
+  Future<void> saveApiKey(String apiKey) async {}
+
+  @override
+  Future<String?> getApiKey() async => null;
+
+  @override
+  Future<void> clearApiKey() async {}
+}
+
+void main() {
+  test('setEnabled(true) 真正调 save() 且 state 终态为 AsyncData (无 deadlock)',
+      () async {
+    final fake = _FakeRepo();
+    final container = ProviderContainer(
+      overrides: [
+        aiSettingsRepositoryProvider.overrideWithValue(fake),
+      ],
+    );
+    addTearDown(container.dispose);
+
+    // 等 build() 完 (loading → data)
+    await container.read(aiSettingsProvider.future);
+
+    final notifier = container.read(aiSettingsProvider.notifier);
+    await notifier.setEnabled(true);
+
+    // save 至少被调 1 次 (entity.enabled=true)
+    expect(fake.saveCount, 1, reason: 'setEnabled 必须调 save()');
+    expect(fake.lastSaved?.enabled, true, reason: '保存的 entity.enabled 应为 true');
+
+    // 终态是 AsyncData, 不是 loading
+    final state = container.read(aiSettingsProvider);
+    expect(state, isA<AsyncData<AiSettings>>());
+    expect(state.value?.enabled, true);
+  });
+
+  test('setModelName 真正调 save() 且 state 终态为 AsyncData (无 deadlock)',
+      () async {
+    final fake = _FakeRepo();
+    final container = ProviderContainer(
+      overrides: [
+        aiSettingsRepositoryProvider.overrideWithValue(fake),
+      ],
+    );
+    addTearDown(container.dispose);
+
+    await container.read(aiSettingsProvider.future);
+
+    final notifier = container.read(aiSettingsProvider.notifier);
+    await notifier.setModelName('deepseek-coder');
+
+    expect(fake.saveCount, 1);
+    expect(fake.lastSaved?.modelName, 'deepseek-coder');
+    expect(container.read(aiSettingsProvider), isA<AsyncData<AiSettings>>());
+    expect(container.read(aiSettingsProvider).value?.modelName, 'deepseek-coder');
+  });
+
+  test('recordConsent 真正调 save() 且 state.consentAcceptedAt 有值 (无 deadlock)',
+      () async {
+    final fake = _FakeRepo();
+    final container = ProviderContainer(
+      overrides: [
+        aiSettingsRepositoryProvider.overrideWithValue(fake),
+      ],
+    );
+    addTearDown(container.dispose);
+
+    await container.read(aiSettingsProvider.future);
+
+    final notifier = container.read(aiSettingsProvider.notifier);
+    await notifier.recordConsent();
+
+    expect(fake.saveCount, 1);
+    expect(fake.lastSaved?.consentAcceptedAt, isNotNull);
+    expect(container.read(aiSettingsProvider), isA<AsyncData<AiSettings>>());
+  });
+
+  test('setEnabled(false) 默认值兜底: state.valueOrNull 为 null 时仍能写', () async {
+    // 边界: build() 还在 loading 时调 setEnabled (state.valueOrNull == null),
+    // 老实现里 `final current = state.valueOrNull ?? default` 拿默认值,
+    // 新实现必须保留这个兜底 — 不能崩也不能 deadlock。
+    final fake = _FakeRepo();
+    final container = ProviderContainer(
+      overrides: [
+        aiSettingsRepositoryProvider.overrideWithValue(fake),
+      ],
+    );
+    addTearDown(container.dispose);
+
+    // 不 await future, 直接拿 notifier, 此时 state 还是 loading
+    final notifier = container.read(aiSettingsProvider.notifier);
+    // 给个很短的窗口让 build() 进 loading (不一定完成, 但 state.valueOrNull
+    // 已经是 null 因为还没出 data)
+    await Future<void>.delayed(const Duration(milliseconds: 10));
+
+    await notifier.setEnabled(true);
+
+    // 不管 build() 完没完, save() 必须被调 1 次, 且 saved.enabled=true
+    expect(fake.saveCount, 1, reason: '默认 entity 兜底必须能让 save() 拿到 enabled=true');
+    expect(fake.lastSaved?.enabled, true);
+  });
+}
