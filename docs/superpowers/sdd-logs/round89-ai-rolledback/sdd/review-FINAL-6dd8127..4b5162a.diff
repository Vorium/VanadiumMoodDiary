@@ -0,0 +1,53 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助) FIX: AI 设置实体
+//
+// FIX-Round-1 改名: AiSettingsEntity → AiSettings, 文件同步 ai_settings_entity.dart
+// → ai_settings.dart, 去掉 scripts/check_all.dart 里的 _spOnlyEntities 豁免。
+//
+// 命名理由 (Reviewer 反馈): *Entity 后缀强制对应 drift table, 但 AI settings 走
+// SharedPreferences + FlutterSecureStorage 不写 DB, 加豁免是 patch — 更干净是直接
+// 不用 *Entity 后缀, 让一致性检查自然通过。4 layer 纯度扫 (lib/domain/entities/*.dart)
+// 仍抓得到这个文件, 0 flutter / 0 drift 保持。
+//
+// 字段:
+// - enabled: 是否启用 AI 辅助 (PIPL §13 默认 false, 需用户主动开启)
+// - provider: LLM provider, 当前只支持 'deepseek'
+// - modelName: 模型名, 默认 'deepseek-chat'
+// - consentAcceptedAt: 用户首次同意 PIPL §13 的 ISO8601 UTC timestamp
+// - consentVersion: 同意版本号, 法务审核用 (本 task 写 '1.0')
+//
+// 隐私: apiKey **不**在此 entity — 走 FlutterSecureStorage, 跟 db_key_service
+// 同 pattern。load() 也不读 key, 避免 entity 暴露 secret。
+
+class AiSettings {
+  final bool enabled;
+  final String provider;
+  final String modelName;
+  final String? consentAcceptedAt;
+  final String consentVersion;
+
+  const AiSettings({
+    required this.enabled,
+    required this.provider,
+    required this.modelName,
+    this.consentAcceptedAt,
+    required this.consentVersion,
+  });
+
+  bool get hasConsent => consentAcceptedAt != null;
+
+  AiSettings copyWith({
+    bool? enabled,
+    String? provider,
+    String? modelName,
+    String? consentAcceptedAt,
+    String? consentVersion,
+  }) {
+    return AiSettings(
+      enabled: enabled ?? this.enabled,
+      provider: provider ?? this.provider,
+      modelName: modelName ?? this.modelName,
+      consentAcceptedAt: consentAcceptedAt ?? this.consentAcceptedAt,
+      consentVersion: consentVersion ?? this.consentVersion,
+    );
+  }
+}
