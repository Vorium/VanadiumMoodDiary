diff --git a/lib/presentation/pages/settings/widgets/ai_section.dart b/lib/presentation/pages/settings/widgets/ai_section.dart
new file mode 100644
index 0000000..e90543f
--- /dev/null
+++ b/lib/presentation/pages/settings/widgets/ai_section.dart
@@ -0,0 +1,196 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助) FIX: 设置页 AI 入口
+//
+// FIX-Round-1 修 1 个问题:
+// 3) **TextField 无 controller + setApiKey 无错误反馈**: 原实现用
+//    `onSubmitted: (v) => notifier.setApiKey(v)` — 字段 uncontrolled,
+//    widget 重建时输入丢失; setApiKey 失败也没人知道。修: 改
+//    ConsumerStatefulWidget, 持 TextEditingController, 旁边加"保存"按钮,
+//    setApiKey 包 AsyncValue.guard, 成功/失败都用 SnackBar 反馈。
+//
+// 模式: 跟 cbt_section.dart / reminders_section.dart 同 — Card + consumer
+// 内部: Switch (enable) + TextField (api key, controller) + 保存按钮 +
+// Dropdown (model) + 测试连接
+// 首次 toggle on 时弹 AiConsentDialog (PIPL §13 单独同意)
+//
+// v0.30 round 89 Task 5 (i18n): 替换 13 个 hardcoded 中文 placeholder → ARB key
+// (aiSectionTitle / aiSectionHint / aiEnableToggle / aiApiKeyLabel /
+// aiApiKeyHint / aiModelLabel / aiModelDeepseekChat / aiTestConnection /
+// aiTestConnectionPending / aiApiKeySaved / aiSaveFailed /
+// aiEmptyApiKeyHint / aiLoadSettingsFailed)
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'package:chroniccare/core/theme/app_tokens.dart';
+import 'package:chroniccare/l10n/app_localizations.dart';
+import 'package:chroniccare/presentation/pages/settings/widgets/ai_consent_dialog.dart';
+import 'package:chroniccare/presentation/providers/ai_settings_provider.dart';
+
+class AiSection extends ConsumerStatefulWidget {
+  const AiSection({super.key});
+
+  @override
+  ConsumerState<AiSection> createState() => _AiSectionState();
+}
+
+class _AiSectionState extends ConsumerState<AiSection> {
+  // FIX-Round-1: TextField controller — 持有输入文本, 重建不丢; dispose 时释放。
+  late final TextEditingController _apiKeyController;
+
+  @override
+  void initState() {
+    super.initState();
+    _apiKeyController = TextEditingController();
+  }
+
+  @override
+  void dispose() {
+    _apiKeyController.dispose();
+    super.dispose();
+  }
+
+  /// 调 notifier.setApiKey 包 try/catch (setApiKey 不改 entity state, 只写
+  /// secure storage, 不走 AsyncValue.loading 流); 成功/失败都用 SnackBar 反馈。
+  Future<void> _saveApiKey() async {
+    final key = _apiKeyController.text.trim();
+    if (key.isEmpty) {
+      final l10n = AppLocalizations.of(context);
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(l10n.aiEmptyApiKeyHint)),
+      );
+      return;
+    }
+    final notifier = ref.read(aiSettingsProvider.notifier);
+    try {
+      await notifier.setApiKey(key);
+      if (!mounted) return;
+      final l10n = AppLocalizations.of(context);
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(l10n.aiApiKeySaved)),
+      );
+    } catch (e) {
+      if (!mounted) return;
+      final l10n = AppLocalizations.of(context);
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(l10n.aiSaveFailed(e.toString()))),
+      );
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = AppLocalizations.of(context);
+    final settingsAsync = ref.watch(aiSettingsProvider);
+    final notifier = ref.read(aiSettingsProvider.notifier);
+
+    return settingsAsync.when(
+      loading: () => const Card(
+        child: Padding(
+          padding: EdgeInsets.all(AppTokens.spacingMd),
+          child: Center(child: CircularProgressIndicator()),
+        ),
+      ),
+      error: (e, st) => Card(
+        child: Padding(
+          padding: const EdgeInsets.all(AppTokens.spacingMd),
+          child: Text(l10n.aiLoadSettingsFailed(e.toString())),
+        ),
+      ),
+      data: (settings) => Card(
+        child: Padding(
+          padding: const EdgeInsets.symmetric(
+            horizontal: AppTokens.spacingMd,
+            vertical: AppTokens.spacingSm,
+          ),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(
+                l10n.aiSectionTitle,
+                style: AppTokens.textStyleTitle(context),
+              ),
+              const SizedBox(height: AppTokens.spacingXxs),
+              Text(
+                l10n.aiSectionHint,
+                style: AppTokens.textStyleCaption(context),
+              ),
+              SwitchListTile(
+                title: Text(l10n.aiEnableToggle),
+                value: settings.enabled,
+                onChanged: (v) async {
+                  // 首次启用 + 还没同意 → 弹 PIPL §13 dialog
+                  if (v && !settings.hasConsent) {
+                    final accepted = await showDialog<bool>(
+                      context: context,
+                      builder: (_) => const AiConsentDialog(),
+                    );
+                    if (accepted != true) return;
+                    if (!mounted) return;
+                    await notifier.recordConsent();
+                  }
+                  if (!mounted) return;
+                  await notifier.setEnabled(v);
+                },
+              ),
+              // FIX-Round-1: TextField 用 controller 持有文本 (重建不丢), 不再
+              // 依赖 onSubmitted 隐式保存; 旁边加"保存"按钮让保存动作显式,
+              // 也让 widget test 可以点保存而不是依赖 onSubmitted 不稳的 IME 流程。
+              Row(
+                crossAxisAlignment: CrossAxisAlignment.end,
+                children: [
+                  Expanded(
+                    child: TextField(
+                      controller: _apiKeyController,
+                      decoration: InputDecoration(
+                        labelText: l10n.aiApiKeyLabel,
+                        hintText: l10n.aiApiKeyHint,
+                        border: const OutlineInputBorder(),
+                      ),
+                      obscureText: true,
+                      enabled: settings.enabled,
+                    ),
+                  ),
+                  const SizedBox(width: AppTokens.spacingXs),
+                  FilledButton.tonal(
+                    onPressed: settings.enabled ? _saveApiKey : null,
+                    child: Text(l10n.commonSave),
+                  ),
+                ],
+              ),
+              const SizedBox(height: AppTokens.spacingXs),
+              DropdownButtonFormField<String>(
+                initialValue: settings.modelName,
+                decoration: InputDecoration(
+                  labelText: l10n.aiModelLabel,
+                  border: const OutlineInputBorder(),
+                ),
+                items: [
+                  DropdownMenuItem(
+                    value: 'deepseek-chat',
+                    child: Text(l10n.aiModelDeepseekChat),
+                  ),
+                ],
+                onChanged: settings.enabled
+                    ? (v) {
+                        if (v != null) notifier.setModelName(v);
+                      }
+                    : null,
+              ),
+              const SizedBox(height: AppTokens.spacingXs),
+              FilledButton.tonal(
+                onPressed: settings.enabled
+                    ? () {
+                        ScaffoldMessenger.of(context).showSnackBar(
+                          SnackBar(content: Text(l10n.aiTestConnectionPending)),
+                        );
+                      }
+                    : null,
+                child: Text(l10n.aiTestConnection),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/presentation/providers/ai_service_provider.dart b/lib/presentation/providers/ai_service_provider.dart
new file mode 100644
index 0000000..3db2c60
--- /dev/null
+++ b/lib/presentation/providers/ai_service_provider.dart
@@ -0,0 +1,44 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助): AiService Riverpod provider
+//
+// 注入链: aiSettingsProvider (AsyncNotifier<AiSettings>) +
+//         aiSettingsRepositoryProvider (Provider<AiSettingsRepository>)
+//         → DeepSeekProvider(apiKey, modelName) → AiService
+//
+// 失败处理:
+// - settings.enabled = false → StateError('AI 未启用')
+//   UI 看 svcAsync.hasError → 按钮 disabled
+// - repo.getApiKey() == null/empty → StateError('请先设置 API Key')
+//   UI 看 svcAsync.hasError → 按钮 disabled
+//
+// 隐私: apiKey 走 FlutterSecureStorage, 不进 AiSettings entity
+// 脱敏: AiService.generateAll 只发 {score, tags, cbtLevel} 给 LLM
+//
+// 频度: 5/7 栏 wizard 3 个 AI 按钮调, tens/day (用户主动点)
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'package:chroniccare/core/data/services/ai/ai_service.dart';
+import 'package:chroniccare/core/data/services/ai/deepseek_provider.dart';
+import 'package:chroniccare/presentation/providers/ai_settings_provider.dart';
+
+/// 异步注入 AiService — 看 settings + 读 apiKey, 2 步都 await
+///
+/// 异常时抛 StateError, UI 通过 `svcAsync.hasError` 知道按钮是否要 disabled
+/// (具体错误信息在 svcAsync.error, 但 UI 暂不分类型, 统一禁用 + toast)
+final aiServiceProvider = FutureProvider<AiService>((ref) async {
+  final settings = await ref.watch(aiSettingsProvider.future);
+  if (!settings.enabled) {
+    throw StateError('AI 未启用');
+  }
+  final repo = ref.read(aiSettingsRepositoryProvider);
+  final apiKey = await repo.getApiKey();
+  if (apiKey == null || apiKey.isEmpty) {
+    throw StateError('请先设置 API Key');
+  }
+  return AiService(
+    provider: DeepSeekProvider(
+      apiKey: apiKey,
+      modelName: settings.modelName,
+    ),
+  );
+});
diff --git a/lib/presentation/providers/ai_settings_provider.dart b/lib/presentation/providers/ai_settings_provider.dart
new file mode 100644
index 0000000..1455089
--- /dev/null
+++ b/lib/presentation/providers/ai_settings_provider.dart
@@ -0,0 +1,110 @@
+// v0.30 round 89 (sub-spec 5 CBT AI 辅助) FIX: AI 设置 Riverpod provider
+//
+// FIX-Round-1 修 2 个问题:
+// 1) **Deadlock 修**: setEnabled / setModelName / recordConsent 原来在
+//    `state = AsyncValue.loading()` 后 `await future` 拿 current — 但 future
+//    的 completer 只由外层 `state = await AsyncValue.guard(...)` 完成, 形成
+//    self-deadlock, 写方法永远 hang。修: 进入写方法时直接用
+//    `state.value ?? const AiSettings(defaults)` 拿 current, 不依赖 future。
+// 2) **重命名**: AiSettingsEntity → AiSettings, 文件 ai_settings_entity.dart →
+//    ai_settings.dart。PIPL §13 / SP-only entity 走豁免太脏, 改名让 check_all.dart
+//    自然通过, 不需要 _spOnlyEntities 白名单。
+//
+// 模式: AsyncNotifierProvider<AiSettings> — build() 读 repo, set 方法写 repo
+// watch 时 UI 自动 rebuild
+//
+// 设计:
+// - state.value ?? defaults (写方法入口直接拿 current, 不 await future)
+//   跟 R85 reminders_hub Notifier 一致, 让 setEnabled / setModelName /
+//   recordConsent / clear 时 UI 显示 loading
+// - setApiKey 不走 state.loading (写的是 secure storage, 不影响 entity 字段)
+// - 首次同意 dialog 返回 true 才 recordConsent, false 不动 settings
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'package:chroniccare/core/data/repositories/ai_settings/ai_settings_repository_impl.dart';
+import 'package:chroniccare/domain/entities/ai_settings.dart';
+
+final aiSettingsRepositoryProvider = Provider<AiSettingsRepository>((ref) {
+  return AiSettingsRepository();
+});
+
+/// 默认 AiSettings — 写方法在 state 还没 data 时兜底用, 避免取不到 current。
+/// `enabled=false, provider='deepseek', modelName='deepseek-chat'` 跟 repo.load()
+/// 在空 SP 时返的 default 一致, 任何后续 copyWith 都从同一个 baseline 出发。
+const _kDefaultAiSettings = AiSettings(
+  enabled: false,
+  provider: 'deepseek',
+  modelName: 'deepseek-chat',
+  consentVersion: '1.0',
+);
+
+class AiSettingsNotifier extends AsyncNotifier<AiSettings> {
+  @override
+  Future<AiSettings> build() async {
+    final repo = ref.read(aiSettingsRepositoryProvider);
+    return repo.load();
+  }
+
+  Future<void> setEnabled(bool v) async {
+    final repo = ref.read(aiSettingsRepositoryProvider);
+    // FIX-Round-1 deadlock: 不 await future, 直接拿 state.value 兜底
+    final current = state.value ?? _kDefaultAiSettings;
+    final next = current.copyWith(enabled: v);
+    state = const AsyncValue.loading();
+    state = await AsyncValue.guard(() async {
+      await repo.save(next);
+      return next;
+    });
+  }
+
+  Future<void> setApiKey(String key) async {
+    final repo = ref.read(aiSettingsRepositoryProvider);
+    await repo.saveApiKey(key);
+  }
+
+  Future<void> setModelName(String name) async {
+    final repo = ref.read(aiSettingsRepositoryProvider);
+    final current = state.value ?? _kDefaultAiSettings;
+    final next = current.copyWith(modelName: name);
+    state = const AsyncValue.loading();
+    state = await AsyncValue.guard(() async {
+      await repo.save(next);
+      return next;
+    });
+  }
+
+  Future<void> recordConsent() async {
+    final repo = ref.read(aiSettingsRepositoryProvider);
+    final current = state.value ?? _kDefaultAiSettings;
+    final next = current.copyWith(
+      consentAcceptedAt: DateTime.now().toUtc().toIso8601String(),
+    );
+    state = const AsyncValue.loading();
+    state = await AsyncValue.guard(() async {
+      await repo.save(next);
+      return next;
+    });
+  }
+
+  Future<void> clear() async {
+    state = const AsyncValue.loading();
+    state = await AsyncValue.guard(() async {
+      final repo = ref.read(aiSettingsRepositoryProvider);
+      await repo.clearApiKey();
+      const reset = AiSettings(
+        enabled: false,
+        provider: 'deepseek',
+        modelName: 'deepseek-chat',
+        consentVersion: '1.0',
+      );
+      await repo.save(reset);
+      return reset;
+    });
+  }
+}
+
+final aiSettingsProvider =
+    AsyncNotifierProvider<AiSettingsNotifier, AiSettings>(
+  AiSettingsNotifier.new,
+);
