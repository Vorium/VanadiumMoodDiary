+import 'package:chroniccare/presentation/providers/ai_service_provider.dart';
+import 'package:chroniccare/presentation/providers/ai_settings_provider.dart';
+
+/// Mock LLM provider — 返回固定 string (模拟 LLM raw response)
+class _MockProvider implements AiProvider {
+  String response;
+  _MockProvider(this.response);
+  @override
+  Future<String> call(String systemPrompt, String userPrompt) async => response;
+}
+
+/// _FakeSettingsNotifier: enabled=true, 跟 brief 一致
+class _FakeSettingsNotifier extends AsyncNotifier<AiSettings>
+    implements AiSettingsNotifier {
+  bool enabledValue;
+  _FakeSettingsNotifier({this.enabledValue = true});
+  @override
+  Future<AiSettings> build() async => AiSettings(
+        enabled: enabledValue,
+        provider: 'deepseek',
+        modelName: 'deepseek-chat',
+        consentVersion: '1.0',
+        consentAcceptedAt: '2026-08-05T00:00:00Z',
+      );
+  @override
+  Future<void> setEnabled(bool v) async {}
+  @override
+  Future<void> setApiKey(String key) async {}
+  @override
+  Future<void> setModelName(String name) async {}
+  @override
+  Future<void> recordConsent() async {}
+  @override
+  Future<void> clear() async {}
+}
+
+/// _FakeRepo: 控制 getApiKey() 返回值 — null 模拟 API key 未设置
+class _FakeRepo implements AiSettingsRepository {
+  String? apiKeyValue;
+  _FakeRepo({this.apiKeyValue = 'sk-fake-key-for-test'});
+  @override
+  Future<AiSettings> load() async => const AiSettings(
+        enabled: true,
+        provider: 'deepseek',
+        modelName: 'deepseek-chat',
+        consentVersion: '1.0',
+      );
+  @override
+  Future<void> save(AiSettings settings) async {}
+  @override
+  Future<void> saveApiKey(String apiKey) async {}
+  @override
+  Future<String?> getApiKey() async => apiKeyValue;
+  @override
+  Future<void> clearApiKey() async {}
+}
+
+/// 测试用 _TestField: 简单 StatefulWidget 验证 onGenerate callback 被调
+class _TestField extends StatefulWidget {
+  const _TestField({super.key, required this.initialValue});
+  final String initialValue;
+  @override
+  State<_TestField> createState() => _TestFieldState();
+}
+
+class _TestFieldState extends State<_TestField> {
+  late String _value = widget.initialValue;
+  String get value => _value;
+  void setValue(String v) => setState(() => _value = v);
+  @override
+  Widget build(BuildContext context) => Text(_value);
+}
+
+void main() {
+  testWidgets(
+    'CbtAiGenerateButton(alternativeThought) 点 → 拿对应字段 → 调 onGenerate callback',
+    (tester) async {
+      // mock LLM 返回 raw string (AiService 不解析 JSON, 直接透传)
