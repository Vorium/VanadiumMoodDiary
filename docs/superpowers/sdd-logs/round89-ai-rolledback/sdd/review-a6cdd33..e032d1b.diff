+//
+// 不依赖 flutter_secure_storage / shared_preferences (overridden 掉)
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:chroniccare/core/data/repositories/ai_settings/ai_settings_repository_impl.dart';
+import 'package:chroniccare/core/data/services/ai/ai_provider.dart';
+import 'package:chroniccare/core/data/services/ai/ai_service.dart';
+import 'package:chroniccare/domain/entities/ai_settings.dart';
