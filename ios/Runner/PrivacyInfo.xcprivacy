<?xml version="1.0" encoding="UTF-8"?>
<!--
  v0.27 round 61 (R61): Apple PrivacyInfo.xcprivacy (2024-05 强制)
  https://developer.apple.com/documentation/bundleresources/privacy_manifest_files

  列出项目用到的所有 "required reason API" + 原因。
  Apple 要求 2024-05 起新 / 跟新 app 必须填, 否则审核拒。

  用到的 API:
  1. UserDefaults:
     - SharedPreferences (assessment_reminder / safety_config / last_error_capture)
     - flutter_secure_storage 内部 NSUserDefaults 缓存
  2. File timestamp:
     - path_provider 读 file mtime
  3. System boot time:
     - app_lifecycle / WidgetsBindingObserver 检测跨日
  4. Disk space:
     - path_provider / audio 存本机磁盘空间
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
		v0.27 round 67 (Sprint 1 上架前 P0, appstore C-P0-10):
		NSPrivacyCollectedDataTypes (Apple 2024-05 起强制必填)
		本项目零云端, 所有数据**仅**存用户设备本地 (SQLCipher + AES-256 字段级加密)。
		"Linked / Tracking / Purposes" 3 维度按 Apple 模板如实声明:
		- Linked: false (数据不跟用户身份绑定, 无云端账户)
		- Tracking: false (零广告 SDK / 零第三方统计)
		- Purposes: AppFunctionality (仅用于 App 本地功能, 不上传)

		4 类数据对应本项目实际处理的敏感个人信息:
		1. HealthAndFitness — PHQ-9 / GAD-7 / 情绪日记 / 药名 / 打卡
		2. AudioData — 树洞录音 / 情绪语音 (本地 AES-256 加密)
		3. ContactInfo — 紧急联系人 (失联通知用, R66 起业务暂停, 数据仅本地预存)
		4. UserContent — 树洞文字 / 树洞录音元数据
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealthAndFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeContactInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<!--
					v0.27 R71 (P2-1 appstore 修复): 补 CA92.2 (cross-app 共享)
					项目自身不用 cross-app, 但 SharedPreferences (flutter_secure_storage 备份) 内部
					可能用 App Group 共享, 防御性声明 Apple 抽审不被打回。
				-->
				<string>CA92.2</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryProcessInfo</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!--
					v0.27 R71 (P2-1 appstore 修复): 加 ProcessInfo reason AC67.1
					flutter_local_notifications 17.x 内部可能调 ProcessInfo.processInfo
					取 thermalState / uptime, Apple 抽审要求声明 reason, 防御性补 AC67.1。
				-->
				<string>AC67.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
