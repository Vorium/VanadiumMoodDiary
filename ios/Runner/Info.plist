<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!--
		v0.27 R70 (NEW-2 appstore P1-2): CFBundleDisplayName 走 InfoPlist.strings per-locale
		原因: iOS Info.plist 是单值, per-locale dict 形式被 iOS 忽略
		(所有 locale 都 fallback 到 CFBundleName=chroniccare, 中文用户看英文名 = 病耻感反向)
		修法: Info.plist 留单值 (英文), zh-Hans.lproj/InfoPlist.strings + zh-Hant.lproj/InfoPlist.strings 走多语
	-->
	<key>CFBundleDisplayName</key>
	<string>ChronicCare</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>chroniccare</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		v0.27 R70: 删 NSUserNotificationUsageDescription 老 key
		原因: iOS 10+ 弃用, flutter_local_notifications 17.x 走 UNUserNotificationCenter 不读此 key
		保留误导审核员以为项目走老 API (实际走 iOS 14+ foreground 通知)
		文档与实际: NSMicrophoneUsageDescription / NSSpeechRecognitionUsageDescription
		/ NSPhotoLibraryUsageDescription 是真用的, 保留
	-->
	<!--
		R100 (A-4): usage description 改英文基线, 中文走 InfoPlist.strings
		per-locale 覆盖 (Base=en / zh-Hans / zh-Hant)。之前内联中文 →
		英文 locale 用户权限弹窗显示中文。
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Used for voice input in the mood diary. Processed locally, files stored encrypted.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used for speech-to-text in the mood diary. Processed locally, never uploaded.</string>
	<!--
		v0.27 round 62 (R62): P0-5 NSPhotoLibraryAddUsageDescription
		PDF 用药报告通过 share_plus 触发 PHPhotoLibrary 调用
		缺此 key iOS 审核拒
	-->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Used to save medication report PDFs to your photo library.</string>
	<!--
		v0.27 round 67 (R67, Sprint 1 上架前 P0, appstore C-P0-7):
		NSPhotoLibraryUsageDescription
		share_plus 10.1.4 + printing 5.13.4 触发 UIActivityViewController
		分享 PDF 时调 PHPhotoLibrary 选保存位置。缺此 key iOS 14+ 直接闪退
		(运行时弹 "This app has crashed because it attempted to access
		privacy-sensitive data without a usage description")。
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to choose where to save when sharing medication report PDFs.</string>
	<!--
		v0.27 round 61 (R61): 项目无 IDFA, 但加 NSUserTrackingUsageDescription
		作为防御性 + App Store 透明性
	-->
	<key>NSUserTrackingUsageDescription</key>
	<string>This app does not collect any tracking data. This declaration is for App Store transparency only.</string>
	<!--
		v0.27 round 61 (R61): iPadOS 多任务 / Split View
		UIRequiresFullScreen=false 允许 iPad Split View 多任务
		精神心理患者在 iPad 上同时记录 + 看视频教程很常见
	-->
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!--
		v0.27 round 62 (R62): P0-1 ITSAppUsesNonExemptEncryption
		Apple 2024 强制 export compliance 声明
		精神心理患者数据走 SQLCipher AES-256 + FlutterSecureStorage Keychain
		属"标准库加密"(无自定义加密算法), 标 false
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!--
		v0.27 R70 (P2-3 appstore 修复): 删 UIMainStoryboardFile
		原因: Scene 模式 (UIApplicationSceneManifest / UISceneStoryboardFile) 已接管
		启动流程, UIMainStoryboardFile 重复声明是冗余。
		实际启动走 SceneDelegate → UISceneStoryboardFile=Main, UIMainStoryboardFile
		被 iOS 忽略但声明让审核员困惑'有 2 个 storyboard?'。
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
		v0.27 round 66 (R66) 上架修正: LSApplicationCategoryType
		Apple App Store Connect 提交时需要这个 key 跟 iTunes Connect 后台勾选的
		Primary Category 呼应。本项目归 Health & Fitness → Medical 类别。
		缺失: Apple 审核员 review 时找不到分类对应,可能被打回"信息缺失"。
		参考: Apple HIG + App Store Review Guidelines §1.4.1 Physical Harm / Medical。
	-->
	<key>LSApplicationCategoryType</key>
	<string>healthcare-fitness</string>
	<!--
		v0.30 R100 (P0#6, appstore A-3): 删 UIBackgroundModes audio+processing +
		BGTaskSchedulerPermittedIdentifiers 声明。原因: ventAudio / 失联通知业务
		均 FeatureFlags 关闭, 声明的后台能力无实际使用 = Apple 2.5.4 拒因。
		业务真接时 (vent 语音录音 / BGProcessingTask 失联检测) 再加回:
		UIBackgroundModes=[audio, processing] + BGTaskSchedulerPermittedIdentifiers
		=[com.chroniccare.safety-check] + AppDelegate.swift BGTaskScheduler.register。
	-->
</dict>
</plist>
