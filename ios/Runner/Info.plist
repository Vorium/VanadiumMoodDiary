<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!--
		v0.27 R70 (NEW-2 appstore P1-2): CFBundleDisplayName 走 InfoPlist.strings per-locale
		原因: iOS Info.plist 是单值, per-locale dict 形式被 iOS 忽略
		(所有 locale 都 fallback 到 CFBundleName=chroniccare, 中文用户看英文名 = 病耻感反向)
		修法: Info.plist 留单值 (英文), zh-Hans.lproj/InfoPlist.strings + zh-Hant.lproj/InfoPlist.strings 走多语
	-->
	<key>CFBundleDisplayName</key>
	<string>ChronicCare</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>chroniccare</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		v0.27 R70: 删 NSUserNotificationUsageDescription 老 key
		原因: iOS 10+ 弃用, flutter_local_notifications 17.x 走 UNUserNotificationCenter 不读此 key
		保留误导审核员以为项目走老 API (实际走 iOS 14+ foreground 通知)
		文档与实际: NSMicrophoneUsageDescription / NSSpeechRecognitionUsageDescription
		/ NSPhotoLibraryUsageDescription 是真用的, 保留
	-->
	<!--
		R100 (A-4): usage description 改英文基线, 中文走 InfoPlist.strings
		per-locale 覆盖 (Base=en / zh-Hans / zh-Hant)。之前内联中文 →
		英文 locale 用户权限弹窗显示中文。
	-->
	<!--
		R102 (P0-5) 曾删除, R105 恢复: NSMicrophoneUsageDescription + NSSpeechRecognitionUsageDescription
		原因: R104 FeatureFlags.ventAudioEnabled=true (启用 vent+mood 语音录制),
		录音功能已启用, 必须声明权限否则运行时 crash + Apple Guideline §2.5.1 拒
		(used-but-not-declared)。文案英文基线, 中文走 InfoPlist.strings per-locale。
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to record voice notes for your vent posts and mood journal.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used to transcribe your voice notes into text in the mood journal.</string>
	<!--
		v0.27 round 62 (R62): P0-5 NSPhotoLibraryAddUsageDescription
		PDF 用药报告通过 share_plus 触发 PHPhotoLibrary 调用
		缺此 key iOS 审核拒
	-->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Used to save medication report PDFs to your photo library.</string>
	<!--
		v0.27 round 67 (R67, Sprint 1 上架前 P0, appstore C-P0-7):
		NSPhotoLibraryUsageDescription
		share_plus 10.1.4 + printing 5.13.4 触发 UIActivityViewController
		分享 PDF 时调 PHPhotoLibrary 选保存位置。缺此 key iOS 14+ 直接闪退
		(运行时弹 "This app has crashed because it attempted to access
		privacy-sensitive data without a usage description")。
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to choose where to save when sharing medication report PDFs.</string>
	<!--
		v0.27 round 61 (R61): 项目无 IDFA, 但加 NSUserTrackingUsageDescription
		作为防御性 + App Store 透明性
	-->
	<!--
		R102 (P0-5): 删除 NSUserTrackingUsageDescription
		原因: 项目无 IDFA / ATT 框架使用, 声明 "does not collect tracking data"
		本身可能被 Apple 视为误导 (Guideline §5.1.2)
		v1.0 如接入分析 SDK 再加回。
	-->
	<!--
		v0.27 round 61 (R61): iPadOS 多任务 / Split View
		UIRequiresFullScreen=false 允许 iPad Split View 多任务
		精神心理患者在 iPad 上同时记录 + 看视频教程很常见
	-->
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!--
		v0.27 round 62 (R62): P0-1 ITSAppUsesNonExemptEncryption
		Apple 2024 强制 export compliance 声明
		精神心理患者数据走 SQLCipher AES-256 + FlutterSecureStorage Keychain
		属"标准库加密"(无自定义加密算法), 标 false
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!--
		v0.27 R70 (P2-3 appstore 修复): 删 UIMainStoryboardFile
		原因: Scene 模式 (UIApplicationSceneManifest / UISceneStoryboardFile) 已接管
		启动流程, UIMainStoryboardFile 重复声明是冗余。
		实际启动走 SceneDelegate → UISceneStoryboardFile=Main, UIMainStoryboardFile
		被 iOS 忽略但声明让审核员困惑'有 2 个 storyboard?'。
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
		v0.27 round 66 (R66) 上架修正: LSApplicationCategoryType
		Apple App Store Connect 提交时需要这个 key 跟 iTunes Connect 后台勾选的
		Primary Category 呼应。
		R128e 医疗声称降级 (2026-08-18): healthcare-fitness (医疗类目, 触发
		Health apps 政策审查) → lifestyle (个人开发者无医疗资质, 记录工具定位)。
		参考: Apple HIG + App Store Review Guidelines §1.4.1 Physical Harm。
	-->
	<key>LSApplicationCategoryType</key>
	<string>lifestyle</string>
	<!--
		v0.30 R108 (P0#2, appstore A-3): 恢复 UIBackgroundModes audio
		原因: R100 (2026-08-08) 因 ventAudio 业务 FeatureFlags 关闭删 audio,
		但 R104 (2026-08-09) 已将 FeatureFlags.ventAudioEnabled 翻 true
		(vent+mood 语音录音真接)。声明跟实际能力不匹配, Apple 2.5.4 拒因,
		且录音时 App 进后台被系统秒杀 = 录音丢失 + 用户体验崩。
		R108 决策: 只恢复 audio (vent 录音后台继续录制), 不恢复 processing
		(BGProcessingTask 失联检测等阿里云 SMS 真接后再加)。
		加 R108 注释标记 + R100 删/恢复的来龙去脉, 防御未来再误删。
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
