/* v0.27 R77 (R74 AS-P0-4 半修续): InfoPlist.strings Base 必备
 *
 * pbxproj PBXVariantGroup 引用 Base + 各 locale 引用。
 * 没 Base 的话 zh-Hans / zh-Hant 走 fallback (R70 注释说
 * "per-locale 覆盖实际从未生效"), Base 是 fallback 兜底,
 * 跟 Info.plist CFBundleDisplayName=MoodDiary 同步。
 *
 * iOS 8+ 强制要求 InfoPlist.strings 有 Base 引用。
 */
"CFBundleDisplayName" = "MoodDiary";

/* R103 (P0-5): 移除 NSMicrophone / NSSpeechRecognition / NSUserTracking
 * R105: 恢复 NSMicrophone / NSSpeechRecognition (R104 ventAudioEnabled=true,
 * 录音业务启用)。NSUserTracking 仍删 (项目无 IDFA)。
 * 现保留实际使用的 4 项权限描述。 */
"NSMicrophoneUsageDescription" = "Used to record voice notes for your vent posts and mood journal.";
"NSSpeechRecognitionUsageDescription" = "Used to transcribe your voice notes into text in the mood journal.";
"NSPhotoLibraryAddUsageDescription" = "Used to save medication report PDFs to your photo library.";
"NSPhotoLibraryUsageDescription" = "Used to choose where to save when sharing medication report PDFs.";
