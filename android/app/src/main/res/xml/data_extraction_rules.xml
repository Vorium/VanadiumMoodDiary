<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.27 round 61 (R61): Android 12+ (API 31+) data extraction 规则

  精神心理患者 PII 严禁 D2D (device-to-device) / cloud backup:
  - 排除 chroniccare.sqlite + flutter_secure_storage
  - 同时禁止 device transfer (换机迁移), 因为含 PII
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="chroniccare.sqlite" />
        <exclude domain="sharedpref" path="flutter_secure_storage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="vent_audio" />
        <exclude domain="file" path="mood_audio" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="chroniccare.sqlite" />
        <exclude domain="sharedpref" path="flutter_secure_storage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="file" path="vent_audio" />
        <exclude domain="file" path="mood_audio" />
    </device-transfer>
</data-extraction-rules>
