<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.27 round 61 (R61) + round 63 (R63, GooglePlay 修复): Android 隐私规范

  R61 修改点:
  1. application 标签加 (3 项 + R63 补 3 项 = 6 项):
     - android:dataExtractionRules (Android 12+)
     - android:fullBackupContent (Android 6.0 - 11)
     - android:networkSecurityConfig (cleartext 禁用)
  R63 补 (GooglePlay P1-1 / P1-4 修复):
     - android:enableOnBackInvokedCallback="true" (Android 13 预测式返回手势)
     - android:debuggable="false" (显式禁 debug, 防误开)
     - android:allowBackup="false" (PIPL §28 精神心理数据禁止 backup)
  注: android:requestLegacyExternalStorage 不加 — app 私有目录够用,
       Android 11+ 该属性已被废弃, 没必要污染 manifest。

  R97 (2026-08-07) 删除 2 项权限 + 1 项硬件特性 + BootReceiver 注册:
  - USE_EXACT_ALARM (R97-P0-6): Google Play 2024-07 起限制为 alarm clock /
    calendar 类 App, 精神心理服药提醒不在允许范围。保留 SCHEDULE_EXACT_ALARM
    (user-revocable, 所有 App 开放) 已够用。
  - RECEIVE_BOOT_COMPLETED + BootReceiver 注册 (R97-P1-10): BootReceiver.kt
    是 R64+ 半成品 (有 TODO), FeatureFlags.bootReceiverEnabled=false 已禁用,
    Android 14+ 对 BroadcastReceiver 后台启动 Activity 有严格限制。当前实现
    context.startActivity 在 Android 14+ 会 crash 或被系统静默拒绝。v1.0
    用 WorkManager + FCM 替代。注: BootReceiver.kt 文件保留作为 v1.0
    WorkManager 实现参考 (无 manifest 注册 = 不会被触发)。
  注: RECORD_AUDIO (R97 曾删, R105 恢复, 见权限区注释)。

  permissions 6 个 + queries 1 个 (PROCESS_TEXT):
  - INTERNET: 见下方权限声明处注释 (R114 更新: in_app_purchase 已在
    1.0.0 删除, 理由改写; debug 构建额外由 src/debug/AndroidManifest.xml
    声明)
  - POST_NOTIFICATIONS: Android 13+ 通知运行时权限
  - SCHEDULE_EXACT_ALARM: user-revocable 精准闹钟 (所有 App 开放)
  - WAKE_LOCK: 通知触发保持 CPU
  - VIBRATE: 通知震动
  - RECORD_AUDIO: vent / mood 录音 (R105 恢复, 见权限区注释)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限声明 ============ -->
    <!-- R114 (BUG 11): INTERNET 权限理由更新。
         原注释称 in_app_purchase 插件隐式依赖 — 1.0.0 已删除 IAP
         (pubspec 无 in_app_purchase), lib/ 全量 grep 0 网络调用
         (零云端产品定位), url_launcher tel: 走 ACTION_DIAL 不依赖
         INTERNET, speech_to_text 平台识别也不需 app 侧权限。
         保守决策: 保留权限不删 — 本机无 Android SDK 无法跑 release
         build 回归验证移除安全性 (移除仅影响 release 包; debug 构建
         的 INTERNET 由 src/debug/AndroidManifest.xml 独立声明,
         Flutter 调试工具链需要)。保留理由: 未来接入隐私政策网页 /
         合规检查时可能需要的网络出口预留。待上架前 release build
         冒烟 + 国内商店权限自检确认后再评估移除。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- R97 (P1-9) 曾强制移除 RECORD_AUDIO, R105 恢复: R104 FeatureFlags
         ventAudioEnabled=true, vent / mood 录音业务启用。record 插件 +
         speech_to_text 插件需要此权限才能录制语音笔记。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
