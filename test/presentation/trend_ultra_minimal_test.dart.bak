// ultra minimal: just check the widget builds without db
import 'package:chroniccare/presentation/pages/trend/trend_page.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

void main() {
  testWidgets('ultra minimal', (tester) async {
    await tester.pumpWidget(
      const MaterialApp(home: TrendPage()),
    );
    await tester.pump();
    debugPrint('pumped once');
  });
}
