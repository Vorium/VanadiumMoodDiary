// v0.12 (Round 6) TrendPage list ↔ calendar 视图切换 widget 测试
import 'package:chroniccare/data/database/app_database.dart';
import 'package:chroniccare/presentation/pages/trend/trend_page.dart';
import 'package:chroniccare/presentation/providers/core_providers.dart';
import 'package:drift/drift.dart' show Value;
import 'package:drift/native.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:shared_preferences/shared_preferences.dart';

void main() {
  setUp(() {
    SharedPreferences.setMockInitialValues({});
  });

  late AppDatabase db;

  setUp(() async {
    db = AppDatabase.forTesting(NativeDatabase.memory());
  });

  tearDown(() async {
    await db.close();
  });

  ProviderScope wrap(Widget child, {List<Override> extra = const []}) {
    return ProviderScope(
      overrides: [
        databaseProvider.overrideWithValue(db),
        ...extra,
      ],
      child: MaterialApp(home: child),
    );
  }

  testWidgets('默认视图是 list 视图，显示"最近 30 天"', (tester) async {
    await tester.pumpWidget(wrap(const TrendPage()));
    // 多次 pump 让 stream emit
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }

    expect(find.text('最近 30 天'), findsOneWidget);
    // 视图切换存在
    expect(find.text('列表'), findsOneWidget);
    expect(find.text('日历'), findsOneWidget);
  });

  testWidgets('点"日历"切换到日历视图', (tester) async {
    await tester.pumpWidget(wrap(const TrendPage()));
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }

    // 初始：list 视图
    expect(find.text('最近 30 天'), findsOneWidget);

    // 切到日历
    await tester.tap(find.text('日历'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 标题变化
    expect(find.text('最近 30 天'), findsNothing);
    // 月份切换按钮存在
    expect(find.byTooltip('上个月'), findsOneWidget);
    expect(find.byTooltip('下个月'), findsOneWidget);
    // 当月显示
    final now = DateTime.now();
    expect(
      find.text('${now.year} 年 ${now.month} 月'),
      findsOneWidget,
    );
  });

  testWidgets('日历视图有 7×6 = 42 个 InkWell（每天一个 tap）', (tester) async {
    await tester.pumpWidget(wrap(const TrendPage()));
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    await tester.tap(find.text('日历'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 找 42 个 InkWell
    final inkWells = find.byType(InkWell);
    expect(inkWells.evaluate().length, greaterThanOrEqualTo(42));
  });

  testWidgets('日历视图：点击某一天，下方显示详情', (tester) async {
    // 插入一条 normal 打卡
    await db.insertCheckIn(CheckInsCompanion.insert(
      timestamp: DateTime(2026, 7, 15, 8, 0),
      type: 'normal',
    ));

    await tester.pumpWidget(wrap(const TrendPage()));
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    await tester.tap(find.text('日历'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 点 "今天" 一定在当月
    final today = DateTime.now();
    final todayCellFinder = find.text('${today.day}').first;
    await tester.tap(todayCellFinder);
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 详情卡片: 一定有"已完成每日打卡"或"未完成每日打卡"
    final hasDone = find.text('已完成每日打卡');
    final hasNotDone = find.text('未完成每日打卡');
    expect(
      hasDone.evaluate().length + hasNotDone.evaluate().length,
      1,
      reason: '点击当天后应显示详情',
    );
  });

  testWidgets('有打卡数据时，日历视图显示打卡信息', (tester) async {
    // 7/15 打卡
    await db.insertCheckIn(CheckInsCompanion.insert(
      timestamp: DateTime(2026, 7, 15, 8, 0),
      type: 'normal',
    ));

    await tester.pumpWidget(wrap(const TrendPage()));
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    await tester.tap(find.text('日历'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 切到 2026-07 月
    for (int i = 0; i < 24; i++) {
      if (find.text('2026 年 7 月').evaluate().isNotEmpty) break;
      await tester.tap(find.byTooltip('上个月'));
      for (int j = 0; j < 2; j++) {
        await tester.pump(const Duration(milliseconds: 50));
      }
    }

    expect(find.text('2026 年 7 月'), findsOneWidget);

    // 选中 7/15
    final cell15 = find.text('15').first;
    await tester.tap(cell15);
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    expect(find.text('已完成每日打卡'), findsOneWidget);
  });

  testWidgets('切回去 = 切到 list 视图', (tester) async {
    await tester.pumpWidget(wrap(const TrendPage()));
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    // 切到日历
    await tester.tap(find.text('日历'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }
    expect(find.text('最近 30 天'), findsNothing);
    // 切回 list
    await tester.tap(find.text('列表'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }
    expect(find.text('最近 30 天'), findsOneWidget);
  });

  testWidgets('情绪记录显示在日历详情里', (tester) async {
    // 7/15 打卡 + 情绪分 4
    await db.insertCheckIn(CheckInsCompanion.insert(
      timestamp: DateTime(2026, 7, 15, 8, 0),
      type: 'normal',
    ));
    await db.insertMoodEntry(MoodEntriesCompanion.insert(
      timestamp: DateTime(2026, 7, 15, 21, 0),
      score: 4,
      tagsJson: const Value('[]'),
    ));

    await tester.pumpWidget(wrap(const TrendPage()));
    for (int i = 0; i < 5; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
    await tester.tap(find.text('日历'));
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 翻到 7 月
    for (int i = 0; i < 24; i++) {
      if (find.text('2026 年 7 月').evaluate().isNotEmpty) break;
      await tester.tap(find.byTooltip('上个月'));
      for (int j = 0; j < 2; j++) {
        await tester.pump(const Duration(milliseconds: 50));
      }
    }

    // 点 15 号
    final cell15 = find.text('15').first;
    await tester.tap(cell15);
    for (int i = 0; i < 3; i++) {
      await tester.pump(const Duration(milliseconds: 100));
    }

    // 详情里有"情绪："
    expect(find.textContaining('情绪：'), findsOneWidget);
  });
}
