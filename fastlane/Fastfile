# v0.27 round 67 (Sprint 1 上架前 P0, appstore C-P0-11): Fastfile
#
# iOS 端 fastlane 配置 + R70 (googleplay GP-P0-8) Android 端 platform :android do 块
#
# 用法:
#   bundle exec fastlane ios beta      # → TestFlight
#   bundle exec fastlane ios release   # → App Store
#   bundle exec fastlane ios metadata  # 只同步 metadata
#   bundle exec fastlane android internal  # → Google Play Internal Testing
#   bundle exec fastlane android production # → Google Play Production
#   bundle exec fastlane android metadata  # 只同步 metadata
#
# 前置 (R67/R70 仍需用户完成):
#   1. fastlane/Appfile 填 apple_id / team_id / itc_team_id 真实值
#   2. App Store Connect API Key 配到 ~/.fastlane/APPLE_ID_KEY_ID.p8
#   3. Android: 配 google_play_json_key_path (Service Account JSON for Play Console)
#      装 fastlane: gem install fastlane
#
# 安全注意: Appfile 不要 commit 真实 apple_id (R67 暂留 TODO, 用户替换)
default_platform(:ios)

platform :ios do
  before_all do
    # 0 副作用: 不自动跑 git pull / git push
    # canger: 高风险 (R67 默认 no)
  end

  desc "Push to TestFlight (internal testing)"
  lane :beta do
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build/ios",
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Release to App Store (Production)"
  lane :release do
    # 0. fail-fast guard (AS-23): 0 截图时禁止一键提交残缺包
    # Apple 新 App 提交至少需 iPhone 6.7"/6.5" 截图; 当前截图由设计师出图 (外部),
    # 出图前跑 release lane 会 build → 上传 → 无截图自动提交 → 被拒/卡审核。
    # 出图后 (fastlane/metadata/ios/*/screenshots/ 非空) 本 guard 自动放行。
    screenshots = Dir.glob(File.join('fastlane', 'metadata', 'ios', '*', 'screenshots', '*'))
    if screenshots.empty?
      UI.user_error!(
        'Release aborted: no screenshots found under fastlane/metadata/ios/*/screenshots/. ' \
        'Apple rejects new app submissions without screenshots. ' \
        'Add screenshots first, or use `fastlane ios metadata` to sync metadata only.'
      )
    end

    # 1. 重新 build
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build/ios",
    )

    # 2. 上传 (不自动提交审核)
    # skip_metadata=false: 上传 fastlane/metadata/ios/* 内容
    # skip_screenshots=false: 上传 fastlane/metadata/ios/*/screenshots/
    # submit_for_review=false: 上传后不自动提交审核, 人工在 ASC 确认无误后手动提交
    #   (R112 AS-23: 防误提交脚枪 — 首次上架前必须人工过一遍 review_information 真实值)
    # automatic_release=false: 审核通过后不自动发布, 手动控制
    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      # v1.0.0+147 起永久免费, 0 个 in-app purchase
    )
  end

  desc "仅同步 metadata + screenshots (不 build / 不上传)"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
    )
  end
end

# v0.27 R70 (googleplay GP-P0-8): Android 端 fastlane 块
# Play Store 上传 metadata 自动化 (跟 iOS deliver 平行)
# Play App Signing 已启用 (R63 Sprint 1 完成), keystore 由 google_play_key
# Service Account JSON 签发
#
# 用法:
#   bundle exec fastlane android internal    # → Internal Testing track
#   bundle exec fastlane android production  # → Production track
#   bundle exec fastlane android metadata    # → 只同步 fastlane/metadata/android/*
#
# 前置:
#   1. 配 google_play_json_key_path (Service Account JSON, Play Console → Setup → API access)
#   2. Android keystore 已配 (见 docs/PLAYSTORE_SIGNING_GUIDE.md)
#   3. 0 0 0 0 0 (R70: Play Console 4 大表单仍 0 维护, 提交前必填)
platform :android do
  before_all do
    # 0 副作用: 不自动跑 git pull / git push
  end

  desc "Build & upload to Google Play Internal Testing"
  lane :internal do
    # v0.27 R70: build_aab (Gradle) 走 release 模式, 产出 .aab
    # R67 已配 signingConfigs.release (读 key.properties 缺则 fallback debug)
    # R70 推荐: 上 store 前用真实 keystore
    gradle(
      task: "bundleRelease",
      project_dir: "android/",
      flags: "--no-daemon",
    )
    upload_to_play_store(
      track: "internal",
      release_status: "completed",
      skip_upload_apk: true,           # 只传 .aab
      skip_upload_aab: false,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      validate_only: false,             # 改成 true 只验证不真传
    )
  end

  desc "Promote to Google Play Production"
  lane :production do
    # Promote internal track 到 production (Google Play 自动处理)
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,            # production 推 promote, 不需要新传 aab
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "仅同步 metadata + screenshots + feature_graphic (不 build / 不上传 aab)"
  lane :metadata do
    upload_to_play_store(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,            # 只同步 metadata
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      validate_only: true,              # 验证不真传 (R70 简化)
    )
  end
end
